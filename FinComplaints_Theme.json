{
  "name": "Cumulus Midnight",
  "dataColors": ["#4F7CFF", "#22C3A6", "#F5B841", "#FF6B8B", "#9B7BFF", "#5AC8FA", "#8A94A6", "#2E3A59"],
  "background": "#FFFFFF",
  "foreground": "#1B2A4A",
  "tableAccent": "#4F7CFF",
  "good": "#22C3A6",
  "neutral": "#F5B841",
  "bad": "#FF6B8B",
  "maximum": "#1F3A93",
  "center": "#5B8DEF",
  "minimum": "#DCE7FF",
  "textClasses": {
    "title": { "fontFace": "Segoe UI Semibold", "fontSize": 12, "color": "#1B2A4A" },
    "callout": { "fontFace": "Segoe UI Bold", "fontSize": 26, "color": "#1B2A4A" },
    "label": { "fontFace": "Segoe UI", "fontSize": 9, "color": "#5A6782" },
    "header": { "fontFace": "Segoe UI Semibold", "fontSize": 11, "color": "#1B2A4A" }
  },
  "visualStyles": {
    "page": {
      "*": {
        "background": [{ "color": { "solid": { "color": "#EEF2F9" } }, "transparency": 0 }],
        "outspace": [{ "color": { "solid": { "color": "#EEF2F9" } } }]
      }
    },
    "*": {
      "*": {
        "background": [{ "show": true, "color": { "solid": { "color": "#FFFFFF" } }, "transparency": 0 }],
        "border": [{ "show": false }],
        "dropShadow": [{ "show": true, "preset": "BottomRight", "color": { "solid": { "color": "#1B2A4A" } }, "transparency": 88 }],
        "visualHeader": [{ "show": false }],
        "title": [{ "show": true, "fontColor": { "solid": { "color": "#1B2A4A" } }, "fontSize": 12, "bold": true }],
        "padding": [{ "top": 10, "bottom": 10, "left": 12, "right": 12 }]
      }
    }
  }
}
